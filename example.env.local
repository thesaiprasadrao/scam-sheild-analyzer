# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-nextauth-secret-here

# Newsdata.io — get key at https://newsdata.io/
NEWSDATA_API_KEY=your-newsdata-api-key-here

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/scamshield?appName=scam-sheild

# Backend URL (set to your Railway deployment URL in production)
NEXT_PUBLIC_BACKEND_URL=https://your-railway-url.up.railway.app
